{
  "openapi": "3.0.0",
  "paths": {
    "/countries": {
      "get": {
        "description": "Retrieves a list of all countries, optionally filtered by name",
        "operationId": "CountryController_findAll",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Search term to filter countries by name",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isLandlocked",
            "required": false,
            "in": "query",
            "description": "Filter countries by landlocked status",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of countries retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryResponseDto"
                  }
                }
              }
            }
          }
        },
        "summary": "Get all countries",
        "tags": [
          "countries"
        ]
      },
      "put": {
        "description": "Creates a new country or updates an existing one based on the three-letter code",
        "operationId": "CountryController_upsert",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountryUpsertDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Country created or updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryResponseDto"
                }
              }
            }
          }
        },
        "summary": "Create or update a country",
        "tags": [
          "countries"
        ]
      }
    },
    "/countries/{code}": {
      "get": {
        "description": "Retrieves detailed information about a specific country",
        "operationId": "CountryController_findOne",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "description": "The three-letter country code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Country details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Country not found"
          }
        },
        "summary": "Get country by code",
        "tags": [
          "countries"
        ]
      },
      "delete": {
        "description": "Deletes a country by its three-letter code",
        "operationId": "CountryController_delete",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "path",
            "description": "The three-letter country code",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Country deleted successfully"
          },
          "400": {
            "description": "Cannot delete country because it is still being used in puzzles"
          },
          "404": {
            "description": "Country not found"
          }
        },
        "summary": "Delete a country",
        "tags": [
          "countries"
        ]
      }
    },
    "/countries/bulk": {
      "put": {
        "description": "Updates multiple countries at once using a dictionary of country codes to partial update objects",
        "operationId": "CountryController_bulkUpdate",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Countries updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CountryResponseDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid update data provided"
          },
          "401": {
            "description": "Invalid or missing API key"
          }
        },
        "summary": "Bulk update countries",
        "tags": [
          "countries"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Returns the health status of the API",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API is healthy"
          }
        },
        "summary": "Health check",
        "tags": [
          "health"
        ]
      }
    },
    "/puzzles": {
      "get": {
        "description": "Retrieves a paginated list of puzzles with optional filtering",
        "operationId": "PuzzleController_findMany",
        "parameters": [
          {
            "name": "countryCode",
            "required": false,
            "in": "query",
            "description": "Filter puzzles by country code",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number for pagination",
            "schema": {
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Number of items per page",
            "schema": {
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of puzzles retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "puzzles": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PuzzleResponseDto"
                      }
                    },
                    "total": {
                      "type": "number",
                      "description": "Total number of puzzles"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Get all puzzles",
        "tags": [
          "puzzles"
        ]
      },
      "post": {
        "description": "Creates a new puzzle with the given country and clues",
        "operationId": "PuzzleController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePuzzleDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Puzzle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuzzleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid country code or missing clues"
          }
        },
        "summary": "Create puzzle",
        "tags": [
          "puzzles"
        ]
      }
    },
    "/puzzles/{id}": {
      "get": {
        "description": "Retrieves a specific puzzle by ID or a random puzzle if \"random\" is specified",
        "operationId": "PuzzleController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The puzzle ID (integer) or \"random\" for a random puzzle",
            "schema": {
              "enum": [
                "random"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Puzzle details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuzzleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid puzzle ID"
          },
          "404": {
            "description": "Puzzle not found"
          }
        },
        "summary": "Get puzzle by ID or random",
        "tags": [
          "puzzles"
        ]
      },
      "put": {
        "description": "Updates an existing puzzle by its ID",
        "operationId": "PuzzleController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The puzzle ID",
            "schema": {
              "type": "number"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePuzzleDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Puzzle updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PuzzleResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid country code or missing clues"
          },
          "404": {
            "description": "Puzzle not found"
          }
        },
        "summary": "Update puzzle",
        "tags": [
          "puzzles"
        ]
      },
      "delete": {
        "description": "Deletes an existing puzzle by its ID",
        "operationId": "PuzzleController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The puzzle ID",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Puzzle deleted successfully"
          },
          "404": {
            "description": "Puzzle not found"
          }
        },
        "summary": "Delete puzzle",
        "tags": [
          "puzzles"
        ]
      }
    }
  },
  "info": {
    "title": "Every Country Is Unique API",
    "description": "The API for the Every Country Is Unique application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CurrencyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The three-letter currency code"
          },
          "name": {
            "type": "string",
            "description": "The name of the currency"
          },
          "symbol": {
            "type": "string",
            "description": "The currency symbol"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "LanguageDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The three-letter language code"
          },
          "name": {
            "type": "string",
            "description": "The name of the language"
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "CountryResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The three-letter country code"
          },
          "name": {
            "type": "string",
            "description": "The name of the country"
          },
          "flag": {
            "type": "string",
            "description": "The flag emoji of the country"
          },
          "currencies": {
            "description": "The currencies used in the country",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyDto"
            }
          },
          "languages": {
            "description": "The languages spoken in the country",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageDto"
            }
          },
          "population": {
            "type": "number",
            "description": "The population of the country"
          },
          "area": {
            "type": "number",
            "description": "The area of the country in square kilometers"
          },
          "populationDensity": {
            "type": "number",
            "description": "The population density of the country (people per sq km)"
          },
          "isLandlocked": {
            "type": "boolean",
            "description": "Whether the country is landlocked (has no coastline)"
          }
        },
        "required": [
          "code",
          "name",
          "flag"
        ]
      },
      "CountryUpsertDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The three-letter country code"
          },
          "name": {
            "type": "string",
            "description": "The name of the country"
          },
          "flag": {
            "type": "string",
            "description": "The flag emoji of the country"
          },
          "currencyCodes": {
            "description": "The currency codes used in the country",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "languageCodes": {
            "description": "The language codes spoken in the country",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "population": {
            "type": "number",
            "description": "The population of the country"
          },
          "area": {
            "type": "number",
            "description": "The area of the country in square kilometers"
          },
          "populationDensity": {
            "type": "number",
            "description": "The population density of the country (people per sq km)"
          },
          "isLandlocked": {
            "type": "boolean",
            "description": "Whether the country is landlocked (has no coastline)"
          }
        },
        "required": [
          "code",
          "name",
          "flag"
        ]
      },
      "Country": {
        "type": "object",
        "properties": {}
      },
      "ClueResponseDto": {
        "type": "object",
        "properties": {}
      },
      "PuzzleResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "The unique identifier of the puzzle"
          },
          "country": {
            "description": "The country associated with the puzzle",
            "allOf": [
              {
                "$ref": "#/components/schemas/Country"
              }
            ]
          },
          "clues": {
            "description": "The clues associated with the puzzle",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClueResponseDto"
            }
          },
          "alternativeCountries": {
            "type": "array",
            "description": "For each clue, an array of country codes that would match all other clues except this one",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "deduplicationKey": {
            "type": "string",
            "description": "A unique key used to prevent duplicate puzzles",
            "example": "abc123"
          }
        },
        "required": [
          "id",
          "country",
          "clues",
          "deduplicationKey"
        ]
      },
      "CreateClueDto": {
        "type": "object",
        "properties": {}
      },
      "CreatePuzzleDto": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "The country code for the puzzle"
          },
          "clues": {
            "description": "The clues for the puzzle",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateClueDto"
            }
          },
          "alternativeCountries": {
            "type": "array",
            "description": "For each clue, an array of country codes that would match all other clues except this one. Each inner array must contain at least one country code.",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "deduplicationKey": {
            "type": "string",
            "description": "A unique key used to prevent duplicate puzzles",
            "example": "abc123"
          }
        },
        "required": [
          "countryCode",
          "clues",
          "alternativeCountries",
          "deduplicationKey"
        ]
      },
      "UpdatePuzzleDto": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "The country code for the puzzle"
          },
          "clues": {
            "description": "The clues for the puzzle",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateClueDto"
            }
          },
          "alternativeCountries": {
            "type": "array",
            "description": "For each clue, an array of country codes that would match all other clues except this one. Each inner array must contain at least one country code.",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "deduplicationKey": {
            "type": "string",
            "description": "A unique key used to prevent duplicate puzzles",
            "example": "abc123"
          }
        },
        "required": [
          "countryCode",
          "clues",
          "alternativeCountries",
          "deduplicationKey"
        ]
      }
    }
  }
}